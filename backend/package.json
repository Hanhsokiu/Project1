{
  "name": "@doan/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @doan/shared build && nest start --watch",
    "build": "pnpm --filter @doan/shared build && nest build",
    "start": "node dist/main",
    "type-check": "pnpm --filter @doan/shared build && tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "prisma": "prisma",
    "db:test:init": "node scripts/database-test.cjs init",
    "db:test:up": "node scripts/database-test.cjs up",
    "db:test:status": "node scripts/database-test.cjs status",
    "db:test:replay": "node scripts/database-test.cjs replay",
    "db:test:diagnose": "node scripts/database-test.cjs diagnose",
    "test:database-tools": "node --test scripts/database-test.check.cjs scripts/shared-database.check.cjs",
    "db:inspect": "node scripts/shared-database.cjs inspect",
    "db:deploy": "node scripts/shared-database.cjs deploy",
    "pr2b:prepare": "node scripts/prepare-pr2b.cjs",
    "pr2b:validate": "prisma validate --schema prisma/review/pr2b/expand.prisma",
    "pr2b:generate": "prisma generate --schema prisma/review/pr2b/legacy-client.prisma && prisma generate --schema prisma/review/pr2b/expand.prisma && prisma generate --schema prisma/review/steps4-8/schema.prisma",
    "pr2b:rehearse": "node scripts/rehearse-pr2b.cjs",
    "pr2b:replay-chain": "node scripts/replay-pr2b-chain.cjs",
    "pr2b:target-test": "node --test scripts/pr2b-target.check.cjs",
    "type-check:pr2b": "tsc --noEmit --skipLibCheck --strict --experimentalDecorators --emitDecoratorMetadata --target ES2021 --module commonjs prisma/review/pr2b/compatibility.ts",
    "foundation:check": "node scripts/foundation-check.cjs",
    "db:test:active-chain": "node scripts/replay-active-chain.cjs",
    "test:smoke:local": "node scripts/smoke-local.cjs",
    "test:local-tools": "node --test scripts/team-local.check.cjs",
    "test:review-groups:api": "node scripts/test-review-groups.cjs",
    "test:review-groups:upgrade": "node scripts/test-review-group-upgrade.cjs",
    "test:proposal-reviews:api": "node scripts/test-proposal-reviews.cjs",
    "test:proposal-reviews:upgrade": "node scripts/test-proposal-review-upgrade.cjs",
    "test:proposal-versions:api": "node scripts/test-proposal-versions.cjs",
    "test:proposal-lifecycle:api": "node scripts/test-proposal-lifecycle.cjs",
    "test:proposal-versions:upgrade": "node scripts/test-proposal-version-upgrade.cjs",
    "test:proposal-dossiers:api": "node scripts/test-proposal-dossiers.cjs",
    "test:proposal-dossiers:upgrade": "node scripts/test-proposal-dossier-upgrade.cjs",
    "test:guidance-tasks:api": "node scripts/test-guidance-tasks.cjs",
    "test:guidance-tasks:upgrade": "node scripts/test-guidance-task-upgrade.cjs",
    "test:guidance-submissions:api": "node scripts/test-guidance-submissions.cjs",
    "test:guidance-submissions:upgrade": "node scripts/test-guidance-submission-upgrade.cjs",
    "test:guidance-reviews:api": "node scripts/test-guidance-reviews.cjs",
    "test:guidance-reviews:upgrade": "node scripts/test-guidance-review-upgrade.cjs",
    "test:integration:steps4-8:suite": "node scripts/test-steps4-8-suite.cjs",
    "test:integration:steps4-8:browser": "node scripts/test-steps4-8-suite.cjs --browser-only",
    "test:integration:steps4-8:e2e": "node scripts/test-steps4-8-e2e.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "node prisma/seed.cjs",
    "test:integration": "node test/run-integration.cjs",
    "test:http": "node test/step1-http.cjs",
    "test:step2": "node test/step2-http.cjs",
    "test:step3": "node test/step3-http.cjs",
    "test:step3-mail": "node test/step3-mail.cjs",
    "fixture:step3-browser": "node test/step3-http.cjs --browser-fixture",
    "docs:api": "node test/export-openapi.cjs"
  },
  "dependencies": {
    "@doan/shared": "workspace:*",
    "@nestjs/common": "^10.4.1",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.1",
    "@nestjs/event-emitter": "^2.0.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "0.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "playwright-core": "1.56.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.5.4",
    "@types/nodemailer": "^6.4.15",
    "@types/pdfkit": "0.17.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^2.0.5",
    "eslint": "^8.57.1",
    "pdfjs-dist": "4.10.38",
    "prisma": "^5.18.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "pdf-parse": "1.1.1"
  }
}
