{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@common/*": ["./src/common/*"],
      "@auth/*": ["./src/auth/*"],
      "@catalog/*": ["./src/catalog/*"],
      "@term/*": ["./src/term/*"],
      "@registration/*": ["./src/registration/*"],
      "@topic/*": ["./src/topic/*"],
      "@guidance/*": ["./src/guidance/*"],
      "@defense/*": ["./src/defense/*"],
      "@grading/*": ["./src/grading/*"],
      "@report/*": ["./src/report/*"],
      "@notification/*": ["./src/notification/*"],
      "@doan/shared": ["../shared/src/index.ts"],
      "@doan/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules", "dist"]
}
