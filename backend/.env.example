# Backend only. Copy to backend/.env (ignored), then supply your own values.
# Copy exact direct/session URLs from Supabase Dashboard > Connect.
# Direct connection may need IPv6; session pooler is the IPv4 alternative.
# URL-encode special characters in passwords; never place DB URLs in VITE_*.
DATABASE_URL=postgresql://USER:REPLACE_PASSWORD@DB_HOST:5432/postgres?sslmode=require
DIRECT_URL=postgresql://USER:REPLACE_PASSWORD@DB_HOST:5432/postgres?sslmode=require
# Explicitly pin the host before read-only db:inspect can connect.
DB_INSPECT_HOST=DB_HOST
JWT_SECRET=REPLACE_WITH_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_REFRESH_SECRET
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
NODE_ENV=development
PORT=3000
API_PREFIX=api
FRONTEND_URL=http://localhost:5173
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@doan.edu.vn
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_SIZE_MB=50
# Private guidance upload; default policy approved 22/10/2026 (see report 08b).
GUIDANCE_UPLOAD_ENABLED=true
# Optional single-line JSON override matching SubmissionUploadPolicySchema.
# GUIDANCE_UPLOAD_POLICY_JSON=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=gpms@example.test
EMAIL_WORKER_ENABLED=true
# Every 10 seconds, create the first draft for due, closed registration terms.
# Faculty still reviews and publishes the result. Existing plans are preserved.
ASSIGNMENT_WORKER_ENABLED=true
# Optional: PDF_CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
