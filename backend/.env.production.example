# TEMPLATE ONLY. Supply secrets through the host secret manager; never commit real values.
# This file is not loaded automatically and must not replace an existing .env.
NODE_ENV=production
PORT=3000
API_PREFIX=api
FRONTEND_URL=https://frontend.example.invalid
DATABASE_URL=REPLACE_WITH_APPROVED_SUPABASE_RUNTIME_TLS_URL
DIRECT_URL=REPLACE_WITH_APPROVED_SUPABASE_MIGRATION_TLS_URL
JWT_SECRET=GENERATE_STRONG_ACCESS_SECRET_IN_SECRET_MANAGER
JWT_REFRESH_SECRET=GENERATE_STRONG_REFRESH_SECRET_IN_SECRET_MANAGER
# Select a persistent disk OR the opt-in private object adapter described in the storage guide.
STORAGE_GUIDANCE_DRIVER=local
STORAGE_LOCAL_PATH=/var/data/datn-private
STORAGE_MAX_SIZE_MB=50
GUIDANCE_UPLOAD_ENABLED=false
UC17_WRITES_ENABLED=false
UC18_WRITES_ENABLED=false
UC19_WRITES_ENABLED=false
UC20_WRITES_ENABLED=false
UC21_WRITES_ENABLED=false
UC22_WRITES_ENABLED=false
UC23_WRITES_ENABLED=false
UC24_WRITES_ENABLED=false
UC25_WRITES_ENABLED=false
# Integration must not send messages to real recipients.
EMAIL_WORKER_ENABLED=false
GUIDANCE_REMINDERS_ENABLED=false
