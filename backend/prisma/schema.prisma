// Prisma schema cho Hệ thống Quản lý Đồ án Tốt nghiệp
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// ENUMS
// ============================================

enum AccountStatus {
  ACTIVE
  LOCKED
  PENDING_ACTIVATION
}

enum TermStatus {
  DRAFT
  OPEN_REGISTRATION
  CLOSED_REGISTRATION
  IN_PROGRESS
  DEFENDING
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  FINALIZED
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUESTED
  APPROVED
  REJECTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  SUBMITTED
  REVIEWED
  OVERDUE
}

enum DefenseEligibilityStatus {
  PENDING
  ELIGIBLE
  INELIGIBLE
  DEFERRED
}

enum DefermentStatus {
  PENDING
  DEPARTMENT_APPROVED
  FACULTY_APPROVED
  REJECTED
}

enum ExportJobStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

enum NotificationStatus {
  UNREAD
  READ
}

enum ImportJobStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

// ============================================
// V001: AUTH & SYSTEM MODULE
// ============================================

model UserAccount {
  id                 String        @id @default(uuid())
  username           String        @unique
  email              String        @unique
  passwordHash       String        @map("password_hash")
  status             AccountStatus @default(PENDING_ACTIVATION)
  failedLoginCount   Int           @default(0) @map("failed_login_count")
  lastLoginAt        DateTime?     @map("last_login_at")
  mustChangePassword Boolean       @default(true) @map("must_change_password")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  userRoles     UserRole[]
  loginSessions LoginSession[]
  auditLogs     AuditLog[]
  notifications Notification[]
  student       Student?
  lecturer      Lecturer?

  @@map("USER_ACCOUNT")

  pr2bAcademicTermGrantUserId AcademicTermGrant[] @relation("AcademicTermGrant_userId")
  pr2bAssignmentPlanWorkflowFinalizedByUserId AssignmentPlanWorkflow[] @relation("AssignmentPlanWorkflow_finalizedByUserId")
  pr2bAssignmentChangeActorId AssignmentChange[] @relation("AssignmentChange_actorId")
  pr2bProposalVersionWorkflowCreatedByUserId ProposalVersionWorkflow[] @relation("ProposalVersionWorkflow_createdByUserId")
  pr2bProposalVersionWorkflowSubmittedByUserId ProposalVersionWorkflow[] @relation("ProposalVersionWorkflow_submittedByUserId")
  pr2bReviewMembershipHistoryActorId ReviewMembershipHistory[] @relation("ReviewMembershipHistory_actorId")
  pr2bProposalReviewWorkflowStartedByUserId ProposalReviewWorkflow[] @relation("ProposalReviewWorkflow_startedByUserId")
  assignedProposalReviews ProposalReviewWorkflow[] @relation("ProposalReviewWorkflow_assignedByUserId")
  pr2bProposalReviewDecisionDecidedByUserId ProposalReviewDecision[] @relation("ProposalReviewDecision_decidedByUserId")
  pr2bReviewCommentAuthorUserId ReviewComment[] @relation("ReviewComment_authorUserId")
  pr2bDossierFinalizationFinalizedByUserId DossierFinalization[] @relation("DossierFinalization_finalizedByUserId")
  pr2bDossierReceiptReceivedByUserId DossierReceipt[] @relation("DossierReceipt_receivedByUserId")
  pr2bDossierHistoryActorId DossierHistory[] @relation("DossierHistory_actorId")
  pr2bPlanHistoryActorId PlanHistory[] @relation("PlanHistory_actorId")
  pr2bTaskProgressEventActorId TaskProgressEvent[] @relation("TaskProgressEvent_actorId")
  pr2bTaskHistoryActorId TaskHistory[] @relation("TaskHistory_actorId")
  pr2bSubmissionWorkflowSubmittedByUserId SubmissionWorkflow[] @relation("SubmissionWorkflow_submittedByUserId")
  pr2bProgressReviewReviewerUserId ProgressReview[] @relation("ProgressReview_reviewerUserId")
  pr2bFileAssetCreatedByUserId FileAsset[] @relation("FileAsset_createdByUserId")
  pr2bMeetingWorkflowAuthorUserId MeetingWorkflow[] @relation("MeetingWorkflow_authorUserId")
  pr2bMeetingHistoryActorId MeetingHistory[] @relation("MeetingHistory_actorId")
  pr2bEvaluationWorkflowEvaluatorUserId EvaluationWorkflow[] @relation("EvaluationWorkflow_evaluatorUserId")
  pr2bEvaluationHistoryActorId EvaluationHistory[] @relation("EvaluationHistory_actorId")
  pr2bIdempotencyRecordActorId IdempotencyRecord[] @relation("IdempotencyRecord_actorId")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("ROLE")
}

model Permission {
  id          String   @id @default(uuid())
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("PERMISSION")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("USER_ROLE")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("ROLE_PERMISSION")
}

model LoginSession {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  refreshToken String    @map("refresh_token")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("LOGIN_SESSION")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user UserAccount? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("AUDIT_LOG")
}

model Notification {
  @@index([userId, createdAt, id])
  id        String             @id @default(uuid())
  userId    String             @map("user_id")
  title     String
  body      String
  link      String?
  status    NotificationStatus @default(UNREAD)
  createdAt DateTime           @default(now()) @map("created_at")
  readAt    DateTime?          @map("read_at")

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("NOTIFICATION")
}

// ============================================
// V002: CATALOG MODULE
// ============================================

model Department {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lecturers Lecturer[]

  @@map("DEPARTMENT")

  pr2bGrantDepartmentDepartmentId GrantDepartment[] @relation("GrantDepartment_departmentId")
  pr2bResearchAreaWorkflowDepartmentId ResearchAreaWorkflow[] @relation("ResearchAreaWorkflow_departmentId")
  pr2bReviewGroupWorkflowDepartmentId ReviewGroupWorkflow[] @relation("ReviewGroupWorkflow_departmentId")
}

model TitleConfig {
  id           String   @id @default(uuid())
  name         String   @unique
  abbreviation String
  createdAt    DateTime @default(now()) @map("created_at")

  lecturers Lecturer[]

  @@map("TITLE_CONFIG")
}

model TrainingSystem {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  students Student[]

  @@map("TRAINING_SYSTEM")
}

model Lecturer {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  lecturerCode String   @unique @map("lecturer_code")
  fullName     String   @map("full_name")
  departmentId String   @map("department_id")
  titleId      String?  @map("title_id")
  phone        String?
  isActive     Boolean  @default(true) @map("is_active")
  maxStudents  Int      @default(5) @map("max_students")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user                UserAccount          @relation(fields: [userId], references: [id])
  department          Department           @relation(fields: [departmentId], references: [id])
  title               TitleConfig?         @relation(fields: [titleId], references: [id])
  researchAreas       LecturerArea[]
  termLecturers       TermLecturer[]
  advisorAssignments  AdvisorAssignment[]  @relation("AdvisorAssignment")
  reviewerAssignments ReviewerAssignment[] @relation("ReviewerAssignment")
  committeeMembers    CommitteeMember[]

  @@map("LECTURER")

  pr2bAssignmentChangeOldAdvisorId AssignmentChange[] @relation("AssignmentChange_oldAdvisorId")
  pr2bAssignmentChangeNewAdvisorId AssignmentChange[] @relation("AssignmentChange_newAdvisorId")
  pr2bTopicWorkflowConfirmedByAdvisorId TopicWorkflow[] @relation("TopicWorkflow_confirmedByAdvisorId")
  pr2bReviewMembershipHistoryLecturerId ReviewMembershipHistory[] @relation("ReviewMembershipHistory_lecturerId")
}

model Student {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  studentCode      String   @unique @map("student_code")
  fullName         String   @map("full_name")
  trainingSystemId String   @map("training_system_id")
  gpa              Decimal  @default(0) @db.Decimal(4, 2)
  phone            String?
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user           UserAccount    @relation(fields: [userId], references: [id])
  trainingSystem TrainingSystem @relation(fields: [trainingSystemId], references: [id])
  termStudents   TermStudent[]
  registrations  Registration[]
  proposal       Proposal?

  @@map("STUDENT")
}

model ResearchArea {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  lecturerAreas LecturerArea[]
  topics        Topic[]

  @@map("RESEARCH_AREA")

  pr2bResearchAreaWorkflowResearchAreaId ResearchAreaWorkflow? @relation("ResearchAreaWorkflow_researchAreaId")
}

model LecturerArea {
  lecturerId     String @map("lecturer_id")
  researchAreaId String @map("research_area_id")

  lecturer     Lecturer     @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  researchArea ResearchArea @relation(fields: [researchAreaId], references: [id], onDelete: Cascade)

  @@id([lecturerId, researchAreaId])
  @@map("LECTURER_AREA")
}

model ImportJob {
  id          String          @id @default(uuid())
  type        String          // STUDENT | LECTURER
  fileName    String          @map("file_name")
  filePath    String          @map("file_path")
  status      ImportJobStatus @default(QUEUED)
  totalRows   Int             @default(0) @map("total_rows")
  successRows Int             @default(0) @map("success_rows")
  errorRows   Int             @default(0) @map("error_rows")
  errorReport Json?           @map("error_report")
  createdAt   DateTime        @default(now()) @map("created_at")
  completedAt DateTime?       @map("completed_at")

  @@map("IMPORT_JOB")
}

// ============================================
// V003: TERM MODULE
// ============================================

model ThesisTerm {
  id           String     @id @default(uuid())
  code         String     @unique
  name         String
  academicYear String     @map("academic_year")
  semester     Int
  status       TermStatus @default(DRAFT)
  startDate    DateTime   @map("start_date")
  endDate      DateTime   @map("end_date")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  phases            TermPhase[]
  parameters        TermParameter[]
  termLecturers     TermLecturer[]
  termStudents      TermStudent[]
  registrations     Registration[]
  topics            Topic[]
  defenseCommittees DefenseCommittee[]
  exportJobs        ExportJob[]

  @@map("THESIS_TERM")

  pr2bAcademicTermGrantTermId AcademicTermGrant[] @relation("AcademicTermGrant_termId")
  pr2bTermWorkflowTermId TermWorkflow? @relation("TermWorkflow_termId")
  pr2bTermPhaseWorkflowTermId TermPhaseWorkflow[] @relation("TermPhaseWorkflow_termId")
  pr2bTopicWorkflowTermId TopicWorkflow[] @relation("TopicWorkflow_termId")
  pr2bGuidancePeriodTermId GuidancePeriod[] @relation("GuidancePeriod_termId")
  pr2bPeriodRequiredStudentTermId PeriodRequiredStudent[] @relation("PeriodRequiredStudent_termId")
}

model TermPhase {
  id        String   @id @default(uuid())
  termId    String   @map("term_id")
  phaseName String   @map("phase_name")
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isLocked  Boolean  @default(false) @map("is_locked")
  createdAt DateTime @default(now()) @map("created_at")

  term ThesisTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@map("TERM_PHASE")

  pr2bTermPhaseWorkflowPhaseId TermPhaseWorkflow? @relation("TermPhaseWorkflow_phaseId")
}

model TermParameter {
  id          String   @id @default(uuid())
  termId      String   @map("term_id")
  key         String
  value       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  term ThesisTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([termId, key])
  @@map("TERM_PARAMETER")
}

model TermLecturer {
  termId     String @map("term_id")
  lecturerId String @map("lecturer_id")
  quota      Int    @default(5)

  term     ThesisTerm @relation(fields: [termId], references: [id], onDelete: Cascade)
  lecturer Lecturer   @relation(fields: [lecturerId], references: [id], onDelete: Cascade)

  @@id([termId, lecturerId])
  @@map("TERM_LECTURER")
}

model TermStudent {
  pr2bDossierStudentProfile DossierStudentProfile?
  id             String   @id @default(uuid())
  termId         String   @map("term_id")
  studentId      String   @map("student_id")
  createdAt      DateTime @default(now()) @map("created_at")

  term         ThesisTerm    @relation(fields: [termId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id])

  @@unique([termId, studentId])
  @@map("TERM_STUDENT")

  pr2bTopicWorkflowTermStudentId TopicWorkflow? @relation("TopicWorkflow_termStudentId")
  pr2bPeriodRequiredStudentTermStudentId PeriodRequiredStudent[] @relation("PeriodRequiredStudent_termStudentId")
  pr2bWeeklyReportObligationTermStudentId WeeklyReportObligation[] @relation("WeeklyReportObligation_termStudentId")
}

// ============================================
// V004: REGISTRATION & ASSIGNMENT MODULE
// ============================================

model Registration {
  id        String             @id @default(uuid())
  termId    String             @map("term_id")
  studentId String             @map("student_id")
  status    RegistrationStatus @default(PENDING)
  note      String?
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  term              ThesisTerm          @relation(fields: [termId], references: [id])
  student           Student             @relation(fields: [studentId], references: [id])
  preferences       RegistrationPref[]
  advisorAssignment AdvisorAssignment?

  @@unique([termId, studentId])
  @@map("REGISTRATION")
}

model RegistrationPref {
  id              String @id @default(uuid())
  registrationId  String @map("registration_id")
  lecturerId      String @map("lecturer_id")
  preferenceOrder Int    @map("preference_order")

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([registrationId, preferenceOrder])
  @@map("REGISTRATION_PREF")
}

model AssignmentPlan {
  id          String           @id @default(uuid())
  termId      String           @map("term_id")
  status      AssignmentStatus @default(DRAFT)
  createdAt   DateTime         @default(now()) @map("created_at")
  publishedAt DateTime?        @map("published_at")

  advisorAssignments AdvisorAssignment[]

  @@map("ASSIGNMENT_PLAN")

  pr2bTermWorkflowOfficialAssignmentPlanId TermWorkflow? @relation("TermWorkflow_officialAssignmentPlanId")
  pr2bAssignmentPlanWorkflowPlanId AssignmentPlanWorkflow? @relation("AssignmentPlanWorkflow_planId")
}

model AdvisorAssignment {
  id               String   @id @default(uuid())
  assignmentPlanId String   @map("assignment_plan_id")
  registrationId   String   @unique @map("registration_id")
  advisorId        String   @map("advisor_id")
  isManual         Boolean  @default(false) @map("is_manual")
  note             String?
  createdAt        DateTime @default(now()) @map("created_at")

  assignmentPlan AssignmentPlan @relation(fields: [assignmentPlanId], references: [id])
  registration   Registration   @relation(fields: [registrationId], references: [id])
  advisor        Lecturer       @relation("AdvisorAssignment", fields: [advisorId], references: [id])

  @@map("ADVISOR_ASSIGNMENT")

  pr2bAssignmentChangeAssignmentId AssignmentChange[] @relation("AssignmentChange_assignmentId")
  pr2bGuidancePlanWorkflowAssignmentId GuidancePlanWorkflow[] @relation("GuidancePlanWorkflow_assignmentId")
}

// ============================================
// V005: TOPIC & PROPOSAL MODULE
// ============================================

model Topic {
  id             String   @id @default(uuid())
  termId         String   @map("term_id")
  researchAreaId String?  @map("research_area_id")
  title          String
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  term         ThesisTerm     @relation(fields: [termId], references: [id])
  researchArea ResearchArea?  @relation(fields: [researchAreaId], references: [id])
  proposals    Proposal[]
  topicHistory TopicHistory[]

  @@map("TOPIC")

  pr2bTopicWorkflowTopicId TopicWorkflow? @relation("TopicWorkflow_topicId")
}

model TopicHistory {
  id        String   @id @default(uuid())
  topicId   String   @map("topic_id")
  changedBy String   @map("changed_by")
  oldValue  Json     @map("old_value")
  newValue  Json     @map("new_value")
  createdAt DateTime @default(now()) @map("created_at")

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("TOPIC_HISTORY")
}

model Proposal {
  id        String         @id @default(uuid())
  topicId   String         @map("topic_id")
  studentId String         @unique @map("student_id")
  status    ProposalStatus @default(DRAFT)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  topic    Topic             @relation(fields: [topicId], references: [id])
  student  Student           @relation(fields: [studentId], references: [id])
  versions ProposalVersion[]
  reviews  ProposalReview[]
  dossier  ThesisDossier?

  @@map("PROPOSAL")

  pr2bProposalWorkflowProposalId ProposalWorkflow? @relation("ProposalWorkflow_proposalId")
  pr2bProposalReviewWorkflowProposalId ProposalReviewWorkflow[] @relation("ProposalReviewWorkflow_proposalId")
  pr2bDossierFinalizationProposalId DossierFinalization[] @relation("DossierFinalization_proposalId")
  pr2bGuidancePlanWorkflowProposalId GuidancePlanWorkflow[] @relation("GuidancePlanWorkflow_proposalId")
}

model ProposalVersion {
  id         String   @id @default(uuid())
  proposalId String   @map("proposal_id")
  version    Int
  content    Json
  filePath   String?  @map("file_path")
  createdAt  DateTime @default(now()) @map("created_at")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, version])
  @@map("PROPOSAL_VERSION")

  pr2bProposalWorkflowWorkingVersionId ProposalWorkflow[] @relation("ProposalWorkflow_workingVersionId")
  pr2bProposalWorkflowSubmittedVersionId ProposalWorkflow[] @relation("ProposalWorkflow_submittedVersionId")
  pr2bProposalVersionWorkflowVersionId ProposalVersionWorkflow? @relation("ProposalVersionWorkflow_versionId")
  pr2bProposalVersionWorkflowBasedOnVersionId ProposalVersionWorkflow[] @relation("ProposalVersionWorkflow_basedOnVersionId")
  pr2bProposalReviewWorkflowVersionId ProposalReviewWorkflow[] @relation("ProposalReviewWorkflow_versionId")
  pr2bProposalReviewDecisionVersionId ProposalReviewDecision[] @relation("ProposalReviewDecision_versionId")
  pr2bReviewCommentVersionId ReviewComment[] @relation("ReviewComment_versionId")
  pr2bDossierFinalizationVersionId DossierFinalization[] @relation("DossierFinalization_versionId")
}

model ReviewGroup {
  id        String   @id @default(uuid())
  termId    String   @map("term_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  members ReviewGroupMember[]
  reviews ProposalReview[]

  @@map("REVIEW_GROUP")

  pr2bReviewGroupWorkflowGroupId ReviewGroupWorkflow? @relation("ReviewGroupWorkflow_groupId")
  pr2bReviewMembershipHistoryGroupId ReviewMembershipHistory[] @relation("ReviewMembershipHistory_groupId")
}

model ReviewGroupMember {
  reviewGroupId String @map("review_group_id")
  lecturerId    String @map("lecturer_id")

  reviewGroup ReviewGroup @relation(fields: [reviewGroupId], references: [id], onDelete: Cascade)

  @@id([reviewGroupId, lecturerId])
  @@map("REVIEW_GROUP_MEMBER")
}

model ProposalReview {
  id            String    @id @default(uuid())
  proposalId    String    @map("proposal_id")
  reviewGroupId String    @map("review_group_id")
  decision      String?   // APPROVED | REVISION_REQUESTED | REJECTED
  comment       String?
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  proposal    Proposal    @relation(fields: [proposalId], references: [id])
  reviewGroup ReviewGroup @relation(fields: [reviewGroupId], references: [id])

  @@map("PROPOSAL_REVIEW")

  pr2bProposalReviewWorkflowReviewId ProposalReviewWorkflow? @relation("ProposalReviewWorkflow_reviewId")
  pr2bProposalReviewWorkflowSupersededByReviewId ProposalReviewWorkflow[] @relation("ProposalReviewWorkflow_supersededByReviewId")
  pr2bProposalReviewDecisionReviewId ProposalReviewDecision? @relation("ProposalReviewDecision_reviewId")
  pr2bReviewCommentReviewId ReviewComment[] @relation("ReviewComment_reviewId")
}

model ThesisDossier {
  id          String    @id @default(uuid())
  proposalId  String    @unique @map("proposal_id")
  status      String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED
  filePath    String?   @map("file_path")
  submittedAt DateTime? @map("submitted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  proposal Proposal @relation(fields: [proposalId], references: [id])

  @@map("THESIS_DOSSIER")

  pr2bDossierWorkflowDossierId DossierWorkflow? @relation("DossierWorkflow_dossierId")
  pr2bDossierFinalizationDossierId DossierFinalization[] @relation("DossierFinalization_dossierId")
  pr2bDossierHistoryDossierId DossierHistory[] @relation("DossierHistory_dossierId")
}

// ============================================
// V006: GUIDANCE MODULE
// ============================================

model GuidancePlan {
  id          String   @id @default(uuid())
  proposalId  String   @unique @map("proposal_id")
  advisorId   String   @map("advisor_id")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tasks            Task[]
  meetings         GuidanceMeeting[]
  phaseEvaluations PhaseEvaluation[]

  @@map("GUIDANCE_PLAN")

  pr2bGuidancePlanWorkflowPlanId GuidancePlanWorkflow? @relation("GuidancePlanWorkflow_planId")
  pr2bPlanHistoryPlanId PlanHistory[] @relation("PlanHistory_planId")
  pr2bWeeklyReportObligationPlanId WeeklyReportObligation[] @relation("WeeklyReportObligation_planId")
  pr2bTaskWorkflowPlanId TaskWorkflow[] @relation("TaskWorkflow_planId")
  pr2bEvaluationWorkflowPlanId EvaluationWorkflow[] @relation("EvaluationWorkflow_planId")
}

model Task {
  @@index([guidancePlanId, deadline], map: "TASK_guidance_plan_id_deadline_idx")
  id             String     @id @default(uuid())
  guidancePlanId String     @map("guidance_plan_id")
  title          String
  description    String?
  deadline       DateTime
  status         TaskStatus @default(TODO)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

