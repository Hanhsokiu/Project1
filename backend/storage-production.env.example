# Documentation only. Do not copy credentials into Git or enable upload flags
# before the deployment/operator checks in B9-B10-STORAGE-OPERATIONS.md pass.
# These names apply to backend only; never expose them as VITE_* variables.

# Existing compatible default. Render requires a separately provisioned,
# verified persistent disk at the chosen absolute path.
STORAGE_GUIDANCE_DRIVER=local
STORAGE_LOCAL_PATH=/var/data/datn/uploads
STORAGE_MAX_SIZE_MB=50

# Optional private object storage. Switch only after an approved key/size/hash
# inventory, byte backup+restore and migration plan for all guidance/* objects.
# There is no implicit fallback or automatic migration from the local root.
# STORAGE_GUIDANCE_DRIVER=supabase
# STORAGE_SUPABASE_URL=https://PROJECT_REF.supabase.co
# STORAGE_SUPABASE_BUCKET=datn-private-guidance
# STORAGE_SUPABASE_SERVICE_KEY=<set-through-backend-secret-manager>

# Provision the bucket separately with public=false. Audit storage.objects RLS
# so anon/authenticated cannot bypass the application's ownership/assignment
# checks. The service credential belongs only to the backend secret manager.
# Configure backup of object bytes as well as PostgreSQL data and metadata.
