VITE_API_URL=http://localhost:3000/api
# VITE_AUTH_API=true selects the server for every supported module.
# The individual flags below also support isolated development without API auth.
VITE_AUTH_API=true
VITE_TERM_API=true
VITE_CATALOG_API=true
VITE_IMPORT_API=true
VITE_REGISTRATION_API=true
# The role selector only appears when VITE_AUTH_API=false and demo/development is enabled.
VITE_DEMO_MODE=false
