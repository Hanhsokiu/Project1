VITE_API_URL=http://localhost:3000/api
# Bước 1–3 use real API, including assignments, proposals and saved-version PDF.
VITE_AUTH_API=true
VITE_TERM_API=true
VITE_CATALOG_API=true
VITE_IMPORT_API=true
VITE_REGISTRATION_API=true
# UC17 opt-in; also requires VITE_AUTH_API=true. Leave false to preserve demo.
VITE_DEFENSE_CONFIRMATION_API=false
# Student final PDF API opt-in; requires real JWT auth, independent of UC17.
VITE_FINAL_REPORT_API=false
# The role selector only appears when VITE_AUTH_API=false and demo/development is enabled.
VITE_DEMO_MODE=false

# UC18 real roster preview / DRAFT / OPEN. Requires VITE_AUTH_API=true.
VITE_DEFENSE_LIST_API=false
# UC19-21 read/preview only. Real JWT required; no official writes enabled.
VITE_DEFENSE_PLANNING_API=false
## Package F: explicit opt-in; also requires VITE_AUTH_API=true.
VITE_GRADING_API=false
# Grading demo requires VITE_AUTH_API=false AND VITE_DEMO_MODE=true.
# Real authentication with grading disabled shows an unavailable page, never demo marks.
