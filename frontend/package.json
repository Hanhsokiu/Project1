{
  "name": "@doan/frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/test-browser.cjs all",
    "test:e2e:api": "node scripts/test-browser.cjs api",
    "test:e2e:demo": "node scripts/test-browser.cjs demo",
    "test:e2e:headed": "node scripts/test-browser.cjs api --headed",
    "test:e2e:ui": "node scripts/test-browser.cjs api --ui",
    "test:e2e:install": "node scripts/install-playwright.cjs",
    "test:e2e:type-check": "tsc --noEmit -p tsconfig.e2e.json",
    "test:e2e:report": "playwright show-report playwright-report/browser-api --host 127.0.0.1",
    "test:review-groups:browser": "node scripts/test-review-groups-browser.cjs",
    "preview:review-groups": "node scripts/test-review-groups-browser.cjs --interactive",
    "test:proposal-reviews:browser": "node scripts/test-proposal-reviews-browser.cjs",
    "test:proposal-versions:browser": "node scripts/test-proposal-versions-browser.cjs",
    "preview:proposal-versions": "node scripts/test-proposal-versions-browser.cjs --interactive",
    "test:proposal-dossiers:browser": "node scripts/test-proposal-dossiers-browser.cjs",
    "preview:proposal-dossiers": "node scripts/test-proposal-dossiers-browser.cjs --interactive",
    "test:guidance-tasks:browser": "node scripts/test-guidance-tasks-browser.cjs",
    "preview:guidance-tasks": "node scripts/test-guidance-tasks-browser.cjs --interactive",
    "test:guidance-submissions:browser": "node scripts/test-guidance-submissions-browser.cjs",
    "preview:guidance-submissions": "node scripts/test-guidance-submissions-browser.cjs --interactive",
    "test:guidance-reviews:browser": "node scripts/test-guidance-reviews-browser.cjs",
    "preview:guidance-reviews": "node scripts/test-guidance-reviews-browser.cjs --interactive"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@tanstack/react-query": "^5.55.4",
    "@tanstack/react-query-devtools": "^5.55.4",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.1",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
